{
  "name": "fa-ki-desktop",
  "productName": "FA KI Desktop",
  "version": "1.8.9",
  "description": "Deutsche Desktop-App für lokale KI mit Ollama: Chat, PDF-Lesen, Spracheingabe und Vorlesen",
  "main": "main.js",
  "author": "Feridun Agmaz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/core.test.js",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "marked": "^14.1.0",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "dompurify": "^3.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "4.10.38"
  },
  "build": {
    "appId": "de.agmaz.fakidesktop",
    "productName": "FA KI Desktop",
    "copyright": "Feridun Agmaz",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "voice-server/**/*",
      "build/renderer/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.png",
      "artifactName": "FA-KI-Desktop-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1031",
      "shortcutName": "FA KI Desktop"
    },
    "extraResources": [
      {
        "from": "build-bundled/whisper",
        "to": "whisper"
      }
    ]
  }
}