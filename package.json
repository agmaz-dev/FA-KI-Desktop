{
  "name": "fa-ki-desktop",
  "productName": "FA KI Desktop",
  "version": "2.5.4",
  "description": "Deutsche Desktop-App für lokale KI mit eigener Engine: Chat, PDF-Lesen, Spracheingabe und Vorlesen",
  "main": "main.js",
  "author": "Feridun Agmaz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/core.test.js test/tools.test.js test/agent.test.js test/hf.test.js test/engine.test.js test/models.test.js test/mail.test.js test/voice25.test.js test/mcp.test.js",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dir --arm64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "marked": "^14.1.0",
    "nodemailer": "^10.6.0",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "dompurify": "^3.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "4.10.38"
  },
  "build": {
    "appId": "de.agmaz.fakidesktop",
    "productName": "FA KI Desktop",
    "copyright": "Feridun Agmaz",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "voice-server/**/*",
      "!voice-server/**/__pycache__/**",
      "!**/*.pyc",
      "build/renderer/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.ico",
      "artifactName": "FA-KI-Desktop-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build-assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FA KI Desktop braucht das Mikrofon zum Diktieren und für den Gesprächsmodus. Die Aufnahme bleibt auf diesem Mac.",
        "NSCameraUsageDescription": "Wird nicht benutzt."
      },
      "files": [
        "!mac-bundle/**",
        "!llama-x/**",
        "!llama-dl/**",
        "!ptts-dl/**",
        "!ptts-x/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1031",
      "shortcutName": "FA KI Desktop",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "build-bundled/llama",
        "to": "llama"
      },
      {
        "from": "build-bundled/ptts",
        "to": "ptts"
      }
    ]
  }
}
